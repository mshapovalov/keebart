#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    combos {
        compatible = "zmk,combos";

        delete {
            bindings = <&kp DELETE>;
            key-positions = <9 10>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 11>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <35 36>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <4 3>;
        };

        insert {
            bindings = <&kp INS>;
            key-positions = <32 31>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <3 2>;
        };

        left_control {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <18 17>;
        };

        right_control {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <23 24>;
        };

        left_alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <17 16>;
        };

        right_alt {
            bindings = <&kp LALT>;
            key-positions = <24 25>;
        };

        control_alt_left {
            bindings = <&kp LA(LCTRL)>;
            key-positions = <18 17 16>;
        };

        control_alt_right {
            bindings = <&kp LA(LCTRL)>;
            key-positions = <23 24 25>;
        };

        win_f {
            bindings = <&kp LG(F)>;
            key-positions = <4 3 2>;
        };

        win_j {
            bindings = <&kp LG(J)>;
            key-positions = <9 10 11>;
        };

        ringt_win {
            bindings = <&kp LGUI>;
            key-positions = <35 36 37>;
        };

        f_layer {
            bindings = <&mo 4>;
            key-positions = <42 43>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q             &kp W  &kp E  &kp R  &kp T             &kp C_MUTE  &kp C_PP  &kp Y        &kp U  &kp I      &kp O    &kp P                 &kp BSPC
&kp CLCK   &mt LEFT_SHIFT A  &kp S  &kp D  &kp F  &kp G             &kp LALT    &kp RALT  &kp H        &kp J  &kp K      &kp L    &mt RIGHT_SHIFT SEMI  &kp SQT
&kp LSHFT  &kp Z             &kp X  &kp C  &kp V  &kp B                                   &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH              &kp ESC
                                    &mo 5  &mo 1  &lt 1 LEFT_SHIFT                        &lt 3 SPACE  &mo 2  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        nav_layer {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
&trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans  &kp HOME   &kp UP_ARROW    &kp END          &trans  &trans
&trans  &trans  &trans    &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &kp LEFT   &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &kp PIPE  &kp TILDE  &kp PLUS   &trans                  &trans  &kp UNDER  &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans  &trans
                          &trans     &trans     &trans                  &trans  &trans     &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL | HUD | HUI |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL         &kp AT           &kp HASH  &kp DLLR  &kp PRCNT  &kp LCTRL  &kp RCTRL  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &trans    &trans    &trans     &kp LALT   &kp RALT   &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans           &trans           &trans    &trans    &trans                           &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                             &kp LGUI  &trans    &kp SPACE                        &kp RET    &trans     &kp RALT
            >;
        };

        numbers_layer {
            display-name = "EXTRA 1";
            bindings = <
&trans  &kp NUMBER_1     &kp NUMBER_2          &kp NUMBER_3  &kp NUMBER_4  &kp N5  &trans  &trans  &kp NUMBER_6  &kp N7         &kp N8            &kp N9                &kp N0                 &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN           &kp HASH      &kp DOLLAR    &trans  &trans  &trans  &kp CARET     &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans           &kp NON_US_BACKSLASH  &kp GRAVE     &kp EQUAL     &trans                  &trans        &kp MINUS      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &trans                 &trans
                                               &trans        &trans        &trans                  &trans        &trans         &trans
            >;
        };

        func_layer {
            display-name = "EXTRA 2";
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans   &trans
                         &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        system_layer {
            display-name = "EXTRA 3";
            bindings = <
&bt BT_CLR       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans           &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&rgb_ug RGB_TOG  &trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans  &trans
                                             &trans        &trans        &trans                        &trans  &trans  &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
